# Firebase project of ONE customer installation.
# Copy this file to `.env.<customer>.local` (for example `.env.ganesh.local`), fill in the values from
# Firebase console → Project settings → Your apps → Web app → SDK config, then build with:
#     npx vite build --mode <customer>
# The build prints "Firebase project: <id>" — check it is THIS customer's project before you deploy.
# Leave every line empty (or delete the file) to build for the original installation.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# optional (Google Analytics)
VITE_FIREBASE_MEASUREMENT_ID=
